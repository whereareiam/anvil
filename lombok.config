# Anvil's one accessor style: a field `name` is read through `name()` and set through `name(value)`.
# Modules whose framework binds by JavaBean names opt out in their own lombok.config.
config.stopBubbling = true
lombok.accessors.fluent = true

# Anvil binds JSON with Jackson 2 alone.
lombok.jacksonized.jacksonVersion += 2
